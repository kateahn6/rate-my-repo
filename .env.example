# Copy to .env.local and fill in.

# Required. Gemini API key used by /api/roast to generate roasts.
# Get one at https://ai.google.dev/
GEMINI_API_KEY=

# Optional. Raises the GitHub REST API rate limit from 60 to 5,000 requests/hour
# and is also used when fetching files for analysis. A fine-grained token with
# read-only access to public repositories is enough.
GITHUB_TOKEN=
